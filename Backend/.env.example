APP_ENV=local
DATABASE_URL=postgresql+psycopg://ucts:ucts_local_only@localhost:5433/ucts_zone
# Cambiar por un secreto aleatorio (mínimo 32 caracteres). No reutilizar en producción.
OTP_SECRET=change-this-local-secret-before-deploying
AUTH_MODE=local
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:8000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Solo si el app client tiene secreto:
COGNITO_CLIENT_SECRET=
# Para autorizar con el correo principal del catálogo importado:
# CERTIFICATE_CATALOG_SQLITE=data/ucts_certificados.sqlite
CERTIFICATE_GENERATOR_ENABLED=false
OTP_TTL_SECONDS=180
OTP_RESEND_SECONDS=60
SESSION_TTL_SECONDS=3600

# Bucket privado para PDFs emitidos. Dejar vacío hasta configurar S3.
CERTIFICATE_S3_BUCKET=
