{
  "template_id": "simposio-certificate-IV",
  "label": "Simposio Certificate",
  "description": "Simposio IV ",

  "html_file": "template.html",
  "css_file": "styles.css",

  "assets": {
    "background_image": "assets/background.png"
  },

  "defaults": {},

  "required_fields": [
    "nombre",
    "identificacion",
    "tipo_asistencia"
  ],

  "form": {
    "fields": [
      {
        "key": "nombre",
        "label": "nombre del participante",
        "type": "text",
        "required": true,
        "placeholder": "Nombre y apellidos",
        "order": 1
      },
      {
        "key": "identificacion",
        "label": "Número de identificación",
        "type": "text",
        "required": true,
        "placeholder": "123456789",
        "order": 2
      },
      {
        "key": "tipo_asistencia",
        "label": "Tipo de participación",
        "type": "text",
        "required": true,
        "placeholder": "Asistente",
        "order": 3
      }
    ]
  }
}
