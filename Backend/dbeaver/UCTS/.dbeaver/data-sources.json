        "database": "ucts_zone",
        "url": "jdbc:postgresql://localhost:5433/ucts_zone",
        "configurationType": "MANUAL",
        "type": "dev",
        "auth-model": "native",
        "auth-properties": { "userName": "ucts" }
      }
    }
  }
}
